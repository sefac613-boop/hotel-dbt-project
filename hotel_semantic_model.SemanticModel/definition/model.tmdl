model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - bronze_booking"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb"]

ref table weather_api
ref table currency_api
ref table fact_booking
ref table kpi_revenue
ref table dim_city
ref table bronze_booking_table
ref table silver_bookings
ref table silver_events

